# 이 파일을 복사해 backend/.env 를 만들고 실제 값을 채우세요. (.env 는 절대 커밋 금지)
# 변수명은 backend/app/core/config.py 의 Settings 필드와 1:1로 대응합니다.
# 새 변수를 추가할 때는 config.py, 이 파일, backend/README.md 표를 함께 수정하세요.

# DB (docker-compose.yml 기본값과 동일, 로컬 개발 전용)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/routeon

# 인증 (JWT)
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256

# 외부 API 키
KAKAO_REST_API_KEY=
TMAP_APP_KEY=
KMA_API_KEY=
